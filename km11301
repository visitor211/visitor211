        timerBox.classList.remove('hidden');
        badge.innerHTML = '<i class="fa-solid fa-clock"></i> 模式：模擬考試測驗中';
        badge.className = "inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200";
        toggleAllBtn.classList.add('hidden');
        closeAllSolutions();
        showToast("已切換為「模擬考試模式」：解答已隱藏", "info");
      } else {
        practiceBtn.className = "px-3 py-1.5 rounded-md transition-all bg-indigo-600 text-white shadow";
        examBtn.className = "px-3 py-1.5 rounded-md text-slate-300 hover:text-white transition-all";
        timerBox.classList.add('hidden');
        badge.innerHTML = '<i class="fa-solid fa-book-open"></i> 模式：練習與全解析';
        badge.className = "inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-50 text-amber-800 border border-amber-200";
        toggleAllBtn.classList.remove('hidden');
        openAllSolutions();
        showToast("已切換為「練習解析模式」：展開所有詳細推導步驟", "success");
      }
    }

    function toggleSingleSolution(solId) {
      const sol = document.getElementById(solId);
      if (!sol) return;
      const isHidden = sol.classList.contains('hidden');
      if (isHidden) {
        sol.classList.remove('hidden');
        if (window.MathJax) MathJax.typesetPromise([sol]);
      } else {
        sol.classList.add('hidden');
      }
    }

    function openAllSolutions() {
      document.querySelectorAll('.solution-box').forEach(el => {
        el.classList.remove('hidden');
      });
      if (window.MathJax) MathJax.typesetPromise();
      const btn = document.getElementById('toggleAllBtn');
      btn.innerHTML = '<i class="fa-solid fa-chevron-up mr-1"></i> 全部解析收合';
      areAllSolutionsOpen = true;
    }

    function closeAllSolutions() {
      document.querySelectorAll('.solution-box').forEach(el => {
        el.classList.add('hidden');
      });
      const btn = document.getElementById('toggleAllBtn');
      btn.innerHTML = '<i class="fa-solid fa-chevron-down mr-1"></i> 全部解析展開';
      areAllSolutionsOpen = false;
    }

    function toggleAllSolutions() {
      if (areAllSolutionsOpen) {
        closeAllSolutions();
      } else {
        openAllSolutions();
      }
    }

    // Input syncing for Checkbox and Radios
    function bindInputListeners() {
      // Q1 Checkboxes to input-q1 text
      const q1Checkboxes = document.querySelectorAll('input[name="q1_opt"]');
      q1Checkboxes.forEach(cb => {
        cb.addEventListener('change', () => {
          const selected = Array.from(q1Checkboxes).filter(c => c.checked).map(c => c.value);
          document.getElementById('input-q1').value = selected.join('');
          updateAnsweredCount();
        });
      });

      // Q2 Radios to input-q2 text
      const q2Radios = document.querySelectorAll('input[name="q2_opt"]');
      q2Radios.forEach(rb => {
        rb.addEventListener('change', () => {
          if (rb.checked) {
            document.getElementById('input-q2').value = rb.value;
            updateAnsweredCount();
          }
        });
      });

      // Text input listeners to update count
      document.querySelectorAll('input[id^="input-"]').forEach(inp => {
        inp.addEventListener('input', updateAnsweredCount);
      });
    }

    function updateAnsweredCount() {
      let count = 0;
      EXAM_DATA.questions.forEach(q => {
        const elem = document.getElementById('input-' + q.id);
        if (elem) {
          if (q.type === 'checkbox' && elem.checked) count++;
          else if (q.type === 'text' && elem.value.trim().length > 0) count++;
        }
      });
      document.getElementById('answeredCounter').textContent = `已作答 ${count} / ${EXAM_DATA.questions.length} 題`;
    }

    // Submit Exam & Auto-Grading
    function submitExam() {
      let score = 0;
      let correct = 0;
      let wrong = 0;

      EXAM_DATA.questions.forEach((q) => {
        const inputElem = document.getElementById('input-' + q.id);
        if (!inputElem) return;

        let userVal = q.type === 'checkbox' ? inputElem.checked : inputElem.value;
        const isCorrect = q.check(userVal);

        // Find status badge for current question card
        const cardElem = inputElem.closest('.question-card');
        const badgeElem = cardElem ? cardElem.querySelector('.status-badge') : null;

        if (isCorrect) {
          score += q.points;
          correct++;
          if (badgeElem) {
            badgeElem.textContent = `+${q.points} 正確`;
            badgeElem.className = "status-badge text-xs font-semibold px-2 py-0.5 rounded bg-emerald-100 text-emerald-800";
            badgeElem.classList.remove('hidden');
          }
        } else {
          wrong++;
          if (badgeElem) {
            badgeElem.textContent = `0分 錯誤`;
            badgeElem.className = "status-badge text-xs font-semibold px-2 py-0.5 rounded bg-rose-100 text-rose-800";
            badgeElem.classList.remove('hidden');
          }
        }
      });

      // Time spent
      const spentSec = EXAM_DATA.totalTimeSeconds - timerRemaining;
      const spentMin = Math.floor(spentSec / 60);
      const spentRemSec = spentSec % 60;

      // Populate score report
      document.getElementById('finalScore').textContent = score;
      document.getElementById('correctCount').textContent = correct;
      document.getElementById('wrongCount').textContent = wrong;
      document.getElementById('timeSpent').textContent = `${spentMin} 分 ${spentRemSec} 秒`;

      const scoreBox = document.getElementById('scoreReport');
      scoreBox.classList.remove('hidden');
      scoreBox.scrollIntoView({ behavior: 'smooth', block: 'start' });

      showToast(`交卷完成！您的總得分為 ${score} 分`, score >= 60 ? "success" : "warning");
    }

    function resetExam() {
      document.querySelectorAll('input[id^="input-"]').forEach(inp => {
        if (inp.type === 'checkbox') inp.checked = false;
        else inp.value = '';
      });
      document.querySelectorAll('input[name="q1_opt"]').forEach(cb => cb.checked = false);
      document.querySelectorAll('input[name="q2_opt"]').forEach(rb => rb.checked = false);
      document.querySelectorAll('.status-badge').forEach(b => b.classList.add('hidden'));

      document.getElementById('scoreReport').classList.add('hidden');
      timerRemaining = EXAM_DATA.totalTimeSeconds;
      timerRunning = true;
      updateTimerDisplay();
      updateAnsweredCount();
      closeAllSolutions();
      showToast("試卷已成功重置！", "info");
    }

    // Print Handling
    function handlePrintDialog() {
      document.getElementById('printModal').classList.remove('hidden');
    }

    function closePrintModal() {
      document.getElementById('printModal').classList.add('hidden');
    }

    function executePrint(includeSolutions) {
      closePrintModal();
      const solutions = document.querySelectorAll('.solution-box');
      if (includeSolutions) {
        solutions.forEach(s => s.classList.add('print-show'));
      } else {
        solutions.forEach(s => s.classList.remove('print-show'));
      }

      // Allow MathJax to typeset thoroughly before triggering print
      if (window.MathJax) {
        MathJax.typesetPromise().then(() => {
          setTimeout(() => {
            window.print();
          }, 300);
        });
      } else {
        window.print();
      }
    }
  </script>
</body>
</html>